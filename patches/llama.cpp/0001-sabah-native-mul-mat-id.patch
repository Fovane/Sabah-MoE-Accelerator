+// Sabah's optional native MUL_MAT_ID adapter consumes the original read-only
+// host GGUF expert tensor directly. Avoid constructing llama.cpp's enormous
+// full-shaped CUDA copy only for that operation; the adapter performs exact
+// expert residency and uses the authoritative device ids at execution time.
+static bool ggml_backend_sched_sabah_direct_expert(const ggml_tensor * node,
+                                                   const ggml_tensor * src,
+                                                   int src_index) {
+    return std::getenv("SABAH_LLAMA") != nullptr &&
+           src_index == 0 && node->op == GGML_OP_MUL_MAT_ID &&
+           src->buffer != nullptr && ggml_backend_buffer_is_host(src->buffer) &&
+           ggml_is_quantized(src->type) && src->ne[2] > 1;
+}
