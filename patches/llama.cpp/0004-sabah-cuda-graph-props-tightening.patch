+static void sabah_cuda_seg_emit(void * user, int i0, int i1) {
+    sabah_seg_user & u = *(sabah_seg_user *) user;
+    sabah_cuda_run_nodes(*u.ctx, u.cgraph, i0, i1);
+}
+
+static int sabah_cuda_seg_is_split(void * user, int i) {
+    const ggml_tensor * node = ((sabah_seg_user *) user)->cgraph->nodes[i];
+    // Only nodes the scheduler assigned to this backend are this split's
+    // business; the same cgraph is handed over once per split.
+    if ((node->flags & GGML_TENSOR_FLAG_COMPUTE) == 0) {
+        return 0;
+    }
+    return ggml_cuda_sabah_owns_node(node) ? 1 : 0;
+}
+
+static void sabah_cuda_seg_capture_enter(void * user) {
+    GGML_UNUSED(user);
+    std::lock_guard<std::mutex> lock(ggml_cuda_lock);
+    ggml_cuda_lock_counter.fetch_add(1, std::memory_order_relaxed);
+}
+
+static void sabah_cuda_seg_capture_leave(void * user) {
+    GGML_UNUSED(user);
+    std::lock_guard<std::mutex> lock(ggml_cuda_lock);
+    if (ggml_cuda_lock_counter.fetch_sub(1, std::memory_order_relaxed) == 1) {
+        ggml_cuda_lock_cv.notify_all();
+    }
+}
+
+// Returns true when this path handled the graph.
+static bool sabah_cuda_seg_compute(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph * cgraph) {
+    const int cc = ggml_cuda_info().devices[cuda_ctx->device].cc;
+
+    // One cgraph is handed to this backend once per scheduler split, with only
+    // that split's nodes flagged COMPUTE. The first such node identifies the
+    // split, which is what keeps two splits of one graph from sharing entries.
+    int first_compute = -1;
+    bool has_sabah = false;
+    bool needs_sync = false;
+    for (int i = 0; i < cgraph->n_nodes; i++) {
+        const ggml_tensor * node = cgraph->nodes[i];
+        if ((node->flags & GGML_TENSOR_FLAG_COMPUTE) == 0) {
+            continue;
+        }
+        if (first_compute < 0) {
+            first_compute = i;
+        }
+        if (ggml_cuda_sabah_owns_node(node)) {
+            has_sabah = true;
+        } else if (node->op == GGML_OP_MUL_MAT_ID && ggml_cuda_mul_mat_id_needs_sync(node, cc)) {
+            needs_sync = true;
+        }
+    }
+    if (!has_sabah) {
+        sabah_fuse_trace_split(cgraph->n_nodes, first_compute, 0);
+        sabah_seg_note_split(0);
+        return false;
+    }
+    sabah_fuse_trace_split(cgraph->n_nodes, first_compute, 1);
+    // A synchronizing MUL_MAT_ID also needs the host, and may sit inside a
+    // fusion pattern: keep such a graph on the native path.
+    if (needs_sync || !sabah_seg_enabled() ||
+        std::getenv("GGML_CUDA_DISABLE_GRAPHS") != nullptr ||
+        !cuda_ctx->stream_context().concurrent_events.empty()) {
+        sabah_seg_note_split(0);
+        return false;
+    }
+
+    sabah_seg_user u = { cuda_ctx, cgraph };
+    const sabah_seg_callbacks cb = {
+        sabah_cuda_seg_emit, sabah_cuda_seg_is_split,
+        sabah_cuda_seg_capture_enter, sabah_cuda_seg_capture_leave,
+    };
+    if (sabah_seg_run(cgraph->n_nodes, (void * const *) cgraph->nodes, cgraph, first_compute,
+                      cuda_ctx->stream(), &cb, &u) == 0) {
+        sabah_seg_note_split(0);
+        return false;
+    }
+    return true;
+}
+
 static enum ggml_status ggml_backend_cuda_graph_compute(ggml_backend_t backend, ggml_cgraph * cgraph) {
     ggml_backend_cuda_context * cuda_ctx = (ggml_backend_cuda_context *) backend->context;
 
     ggml_cuda_set_device(cuda_ctx->device);
 
+    if (g_sabah_op_times.on) {
+        sabah_cuda_run_nodes(*cuda_ctx, cgraph, 0, cgraph->n_nodes);
+        g_sabah_op_times.flush(cuda_ctx->stream());
+        return GGML_STATUS_SUCCESS;
+    }
+
+    if (sabah_cuda_seg_compute(cuda_ctx, cgraph)) {
+        return GGML_STATUS_SUCCESS;
+    }
+
     bool use_cuda_graph             = false;
     bool cuda_graph_update_required = false;
