+// Optional Sabah native bridge. It is loaded only when SABAH_LLAMA is set;
+// the normal llama.cpp CUDA path remains untouched otherwise. The bridge is
+// deliberately located at MUL_MAT_ID so the real graph supplies the host GGUF
+// tensor, hidden-state device pointer, authoritative ids and output tensor.
+struct sabah_llama_bridge {
+#if defined(_WIN32)
+    HMODULE handle = nullptr;
+#else
+    void * handle = nullptr;
+#endif
+    bool ready = false;
+    using init_fn = int (*)(int);
+    // v2: the input row stride and row count (src1->nb[1], src1->ne[1]) are
+    // part of the MUL_MAT_ID contract. The down projection has one input row
+    // per selected expert; v1 omitted them and fed every slot row 0.
+    using mul_mat_id_fn = int (*) (
+        const void *, size_t, size_t,
+        const void *, size_t, int, size_t,
+        const void *, size_t, size_t, int, int,
+        float *, size_t, size_t,
+        int, int, int, int, void *, const void *);
+    using last_error_fn = const char *(*)();
+    using get_metrics_fn = int (*)(unsigned long long *, unsigned long long *,
+                                   unsigned long long *, unsigned long long *,
+                                   unsigned long long *);
+    init_fn init = nullptr;
+    mul_mat_id_fn mul_mat_id = nullptr;
+    last_error_fn last_error = nullptr;
+    get_metrics_fn get_metrics = nullptr;
+};
+
+static sabah_llama_bridge g_sabah_llama_bridge;
+static std::once_flag g_sabah_llama_once;
+
+static void sabah_bridge_report_metrics() {
+    auto & bridge = g_sabah_llama_bridge;
+    if (!bridge.ready || !bridge.get_metrics || std::getenv("SABAH_LLAMA_TRACE") == nullptr) {
+        return;
+    }
+    unsigned long long hits = 0;
+    unsigned long long misses = 0;
+    unsigned long long evictions = 0;
+    unsigned long long bytes_fetched = 0;
+    unsigned long long resident_bytes = 0;
+    if (bridge.get_metrics(&hits, &misses, &evictions, &bytes_fetched, &resident_bytes) == 0) {
+        std::fprintf(stderr,
+                     "SABAH_METRICS hits=%llu misses=%llu evictions=%llu bytes_fetched=%llu resident_bytes=%llu\n",
+                     hits, misses, evictions, bytes_fetched, resident_bytes);
+    }
+}
+
+static void * sabah_bridge_symbol(sabah_llama_bridge & bridge, const char * name) {
+#if defined(_WIN32)
+    return (void *) GetProcAddress(bridge.handle, name);
+#else
+    return dlsym(bridge.handle, name);
+#endif
+}
+
+static bool sabah_bridge_load() {
+    std::call_once(g_sabah_llama_once, []() {
+        auto & bridge = g_sabah_llama_bridge;
+        const char * configured = std::getenv("SABAH_RT_LIB");
+        const char * path = configured && *configured ? configured :
+#if defined(_WIN32)
+            "sabah_rt.dll";
+#else
+            "libsabah_rt.so";
+#endif
+
+#if defined(_WIN32)
+        bridge.handle = LoadLibraryA(path);
+#else
+        bridge.handle = dlopen(path, RTLD_NOW | RTLD_LOCAL);
+#endif
+        if (!bridge.handle) {
+            GGML_LOG_ERROR("SABAH_LLAMA requested but Sabah runtime could not be loaded: %s\n", path);
+            return;
+        }
+        bridge.init = (sabah_llama_bridge::init_fn) sabah_bridge_symbol(bridge, "sabah_rt_init");
+        bridge.mul_mat_id = (sabah_llama_bridge::mul_mat_id_fn) sabah_bridge_symbol(bridge, "sabah_rt_mul_mat_id_v2");
+        bridge.last_error = (sabah_llama_bridge::last_error_fn) sabah_bridge_symbol(bridge, "sabah_rt_last_error");
+        bridge.get_metrics = (sabah_llama_bridge::get_metrics_fn) sabah_bridge_symbol(bridge, "sabah_rt_get_metrics");
+        if (!bridge.init || !bridge.mul_mat_id || !bridge.last_error || !bridge.get_metrics) {
+            GGML_LOG_ERROR("SABAH_LLAMA runtime is missing the native MUL_MAT_ID ABI\n");
+            return;
+        }
+        if (bridge.init(ggml_cuda_get_device()) != 0) {
+            GGML_LOG_ERROR("SABAH_LLAMA runtime init failed: %s\n", bridge.last_error());
+            return;
+        }
+        bridge.ready = true;
+        std::atexit(sabah_bridge_report_metrics);
+        GGML_LOG_INFO("SABAH_LLAMA native exact-expert backend enabled (%s)\n", path);
+    });
+    return g_sabah_llama_bridge.ready;
+}
+
+static bool sabah_bridge_mul_mat_id(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * src0 = dst->src[0];
+    const ggml_tensor * src1 = dst->src[1];
+    const ggml_tensor * ids  = dst->src[2];
+    if (!sabah_bridge_load()) {
+        return false;
+    }
+    if (!ggml_backend_buffer_is_host(src0->buffer) ||
+        src1->type != GGML_TYPE_F32 || dst->type != GGML_TYPE_F32 ||
+        src1->nb[0] != sizeof(float) || src1->ne[1] > INT_MAX ||
+        ids->type != GGML_TYPE_I32 || src0->ne[0] > INT_MAX ||
+        src0->ne[1] > INT_MAX || src0->ne[2] > INT_MAX ||
+        ids->ne[0] > INT_MAX || ids->ne[1] > INT_MAX) {
+        GGML_LOG_ERROR("SABAH_LLAMA received an unsupported MUL_MAT_ID layout\n");
+        return false;
+    }
+    const int rc = g_sabah_llama_bridge.mul_mat_id(
+        src0->data, src0->nb[2], src0->nb[1],
+        src1->data, src1->nb[1], (int) src1->ne[1], src1->nb[2],
+        ids->data, ids->nb[0], ids->nb[1],
+        (int) ids->ne[0], (int) ids->ne[1],
+        (float *) dst->data, dst->nb[1], dst->nb[2],
+        (int) src0->ne[1], (int) src0->ne[0], (int) src0->ne[2],
+        (int) src0->type, (void *) ctx.stream(), (const void *) ids);
+    if (rc != 0) {
+        GGML_LOG_ERROR("SABAH_LLAMA MUL_MAT_ID failed: %s\n", g_sabah_llama_bridge.last_error());
+        return false;
+    }
+    return true;
+}
