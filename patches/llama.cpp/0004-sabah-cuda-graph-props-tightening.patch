+// [TAG_SABAH_SEG] Segmented CUDA graphs around Sabah-owned nodes.
+//
+// The plan, the capture calls, the cache and the counters are in sabah-seg.cpp,
+// which is compiled by the host compiler. Only what needs this context lives
+// here: the node runner (fusion rule), the split predicate and the capture
+// guard. See docs/CUDA_GRAPH_SPLIT.md.
+
+// [TAG_SABAH_OP_TIMES] Per-node GPU time for the dense path.
+// GGML_CUDA_OP_TIMES=1 runs the graph through the plain node loop and brackets
+// every node with two CUDA events. The stream is synchronized once per token to
+// read them, so wall time from such a run is not a performance number.
+#define SABAH_OP_MAX_SLOTS 8192
+#define SABAH_OP_MAX_NAMES 1024
+
+// "blk.12.ffn_moe_gate" -> ".ffn_moe_gate": the same suffix for every layer, so
+// the 48 layers aggregate without building a new string.
+static const char * sabah_op_fold(const char * name) {
+    if (name != nullptr && std::strncmp(name, "blk.", 4) == 0) {
+        const char * dot = std::strchr(name + 4, '.');
+        if (dot != nullptr) {
+            return dot;
+        }
+    }
+    return name != nullptr ? name : "";
+}
+
+struct sabah_op_times {
+    bool on = std::getenv("GGML_CUDA_OP_TIMES") != nullptr;
+    int n = 0;
+    cudaEvent_t ev[SABAH_OP_MAX_SLOTS][2] = {};
+    const char * name[SABAH_OP_MAX_SLOTS] = {};
+    int op[SABAH_OP_MAX_SLOTS] = {};
+    const char * agg_name[SABAH_OP_MAX_NAMES] = {};
+    int agg_op[SABAH_OP_MAX_NAMES] = {};
+    double agg_ms[SABAH_OP_MAX_NAMES] = {};
+    int n_agg = 0;
+    long long tokens = 0;
+
+    ~sabah_op_times() {
+        if (!on || tokens == 0) {
+            return;
+        }
+        double sum = 0.0;
+        for (int i = 0; i < n_agg; i++) {
+            sum += agg_ms[i];
+        }
+        std::fprintf(stderr, "GGML_OP_TIMES tokens=%lld sum_ms_per_token=%.3f\n",
+                     tokens, sum / (double) tokens);
+        for (int i = 0; i < n_agg; i++) {
+            int best = i;
+            for (int j = i + 1; j < n_agg; j++) {
+                if (agg_ms[j] > agg_ms[best]) {
+                    best = j;
+                }
+            }
+            if (best != i) {
+                std::swap(agg_ms[i], agg_ms[best]);
+                std::swap(agg_name[i], agg_name[best]);
+                std::swap(agg_op[i], agg_op[best]);
+            }
+        }
+        for (int i = 0; i < n_agg; i++) {
+            std::fprintf(stderr, "GGML_OP_TIME %8.3f ms/token %5.1f%%  %s %s\n",
+                         agg_ms[i] / (double) tokens,
+                         sum > 0.0 ? 100.0 * agg_ms[i] / sum : 0.0,
+                         ggml_op_name((enum ggml_op) agg_op[i]), agg_name[i]);
+        }
+    }
+
+    void begin(const ggml_tensor * node, cudaStream_t stream) {
+        if (n >= SABAH_OP_MAX_SLOTS) {
+            return;
+        }
+        if (ev[n][0] == nullptr) {
+            CUDA_CHECK(cudaEventCreateWithFlags(&ev[n][0], cudaEventDefault));
+            CUDA_CHECK(cudaEventCreateWithFlags(&ev[n][1], cudaEventDefault));
+        }
+        name[n] = sabah_op_fold(node->name);
+        op[n] = (int) node->op;
+        CUDA_CHECK(cudaEventRecord(ev[n][0], stream));
+        n++;
+    }
+
+    void end(cudaStream_t stream) {
+        if (n == 0) {
+            return;
+        }
+        CUDA_CHECK(cudaEventRecord(ev[n - 1][1], stream));
+    }
+
+    void flush(cudaStream_t stream) {
+        if (n == 0) {
+            return;
+        }
+        CUDA_CHECK(cudaStreamSynchronize(stream));
+        for (int i = 0; i < n; i++) {
+            float ms = 0.0f;
+            CUDA_CHECK(cudaEventElapsedTime(&ms, ev[i][0], ev[i][1]));
+            int k = 0;
+            while (k < n_agg && (agg_name[k] != name[i] || agg_op[k] != op[i])) {
+                k++;
+            }
+            if (k == n_agg) {
+                if (n_agg >= SABAH_OP_MAX_NAMES) {
+                    continue;
+                }
+                agg_name[n_agg] = name[i];
+                agg_op[n_agg] = op[i];
+                agg_ms[n_agg] = 0.0;
+                n_agg++;
+            }
+            agg_ms[k] += (double) ms;
+        }
+        n = 0;
+        tokens++;
+    }
+};
+
+static sabah_op_times g_sabah_op_times;
+
+// Runs nodes [i0, i1) exactly like the native loop body: same fusion rule, same
+// stream. Used for eager segments, for capture and for op timing.
+static void sabah_cuda_run_nodes(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph,
+                                 int i0, int i1) {
+    for (int i = i0; i < i1; i++) {
+        ggml_tensor * node = cgraph->nodes[i];
+        if (ggml_cuda_is_view_or_noop(node)) {
+            continue;
+        }
+        if ((node->flags & GGML_TENSOR_FLAG_COMPUTE) == 0) {
+            continue;
+        }
+        const int nodes_to_skip = ggml_cuda_try_fuse(&ctx, cgraph, i);
+        sabah_fuse_trace(node, nodes_to_skip);
+        if (nodes_to_skip != 0) {
+            // A pattern must not cross a segment end. Segment ends are Sabah
+            // nodes, and try_fuse refuses any pattern within 8 nodes of one.
+            GGML_ASSERT(i + nodes_to_skip < i1);
+            sabah_seg_note_fusion();
+            i += nodes_to_skip;
+            continue;
+        }
+        if (g_sabah_op_times.on) {
+            g_sabah_op_times.begin(node, ctx.stream());
+        }
+        const bool ok = ggml_cuda_compute_forward(ctx, node);
+        if (g_sabah_op_times.on) {
+            g_sabah_op_times.end(ctx.stream());
+        }
+        GGML_ASSERT(ok);
+    }
+}
