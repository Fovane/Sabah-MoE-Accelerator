+// allocate the device and host staging for the hyper-connection streams of a batch
+bool llama_context::prefill_group_prepare(uint32_t n_tokens) {
+    const int64_t n_embd = model.hparams.n_embd;
+    const int64_t hc     = model.hparams.dsv4_hc_mult;
+
+    if (n_embd <= 0 || hc <= 0 || cparams.n_ubatch == 0) {
+        return false;
+    }
+
+    hc_row_bytes = (size_t) n_embd*hc*sizeof(float);
+
+    if (hc_dev[0] == nullptr) {
+        hc_ctx = ggml_init({
+            /*.mem_size   =*/ 4*ggml_tensor_overhead(),
+            /*.mem_buffer =*/ nullptr,
+            /*.no_alloc   =*/ true,
+        });
+
+        if (hc_ctx == nullptr) {
+            return false;
+        }
+
+        hc_dev[0] = ggml_new_tensor_2d(hc_ctx, GGML_TYPE_F32, n_embd*hc, cparams.n_ubatch);
+        hc_dev[1] = ggml_new_tensor_2d(hc_ctx, GGML_TYPE_F32, n_embd*hc, cparams.n_ubatch);
+
+        hc_buf.reset(ggml_backend_alloc_ctx_tensors_from_buft(hc_ctx, ggml_backend_dev_buffer_type(model.dev_output())));
+
+        if (!hc_buf) {
+            LLAMA_LOG_ERROR("%s: failed to allocate the residual stream buffers\n", __func__);
+
+            return false;
+        }
+
+        ggml_backend_buffer_clear(hc_buf.get(), 0);
+
+        LLAMA_LOG_INFO("%s: residual stream buffer = %8.2f MiB\n", __func__, ggml_backend_buffer_get_size(hc_buf.get())/1024.0/1024.0);
+    }
+
+    const size_t need = (size_t) n_tokens*hc_row_bytes;
+
+    if (hc_host.size() < need) {
+        try {
+            hc_host.assign(need, 0);
+        } catch (const std::bad_alloc &) {
+            LLAMA_LOG_ERROR("%s: cannot stage %6.2f MiB of residual streams in host RAM\n", __func__, need/1024.0/1024.0);
+
+            return false;
+        }
+    }
+
+    return true;
+}
