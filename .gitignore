# build artifacts
*.exe
*.exp
*.lib
*.obj
*.pdb
*.o
*.so
*.dll
*.dll.prev

# python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/

# the installer's llama.cpp checkout: pinned upstream base plus patches 0001/0002
third_party/llama.cpp/

# sabah state (machine-specific measurements)
.sabah/
*.sabah-profile.json

# never commit model weights or traces
*.gguf
*.safetensors
*.bin
traces/
*.trace.jsonl

# scratch
tmp/
scratch/

# scratch run directory; the evidence behind README claims lives in results/
logs/

# `sabah run` scratch output: per-step times, status snapshots, --json dumps
results/_run/

# raw per-token captures from the Phase 0 harness (regenerated by tools/phase0_measure.py)
results/phase0/*/logits.f32
results/phase0/*/report.qdstrm
results/phase0/warm_replay/trace/

# RC3 machine-local raw llama.cpp tensor captures (keep only summaries)
results/correctness_reference/
results/correctness_sabah/
results/correctness_deep_reference/
results/correctness_deep_sabah/
results/correctness_ops_reference/
results/correctness_ops_sabah/
results/correctness_block0_reference/
results/correctness_block0_sabah/
results/correctness_debug/
